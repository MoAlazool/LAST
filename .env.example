# Environment variables for LectureMate

# Node environment
NODE_ENV=development

# Required: Gemini API Key (get from https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Pexels API key (for image search)
PEXELS_API_KEY=

# Optional: Ollama Configuration (for local GPU processing)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# Optional: Python command override
PYTHON_CMD=python3

# Firebase Admin (server-side) — REQUIRED in the cloud so uploaded files persist in
# Firebase Storage (cloud disks are ephemeral). Locally you can instead drop the
# service-account JSON file at ./firebase-service-account.json.
FIREBASE_PROJECT_ID=lecturemate-d0187
FIREBASE_STORAGE_BUCKET=lecturemate-d0187.firebasestorage.app
# On Railway/Render: paste the ENTIRE service-account JSON (one line) as the value below.
FIREBASE_SERVICE_ACCOUNT_KEY=
GOOGLE_APPLICATION_CREDENTIALS=

# Set automatically by the host (Railway/Render). Leave blank locally (defaults to 5000).
PORT=

# Optional: GPU (not used on CPU cloud hosts)
CUDA_VISIBLE_DEVICES=

# ── Split hosting (client on Netlify, backend on Railway) ──
# Client build (set in Netlify): backend origin the browser calls directly. Leave empty when
# the backend serves the client itself (local dev, Docker/Railway only).
VITE_API_BASE_URL=
# Backend (set in Railway): sites allowed to call the API, comma-separated.
CORS_ORIGINS=
# Backend: also allow *.netlify.app deploy previews (true/false).
CORS_ALLOW_NETLIFY_PREVIEWS=false

# Firebase web app config (client; Vite build-time). Firebase Console → Project settings → Your apps.
# Also set these in Netlify → Environment variables.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=lecturemate-d0187.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=lecturemate-d0187
VITE_FIREBASE_STORAGE_BUCKET=lecturemate-d0187.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
